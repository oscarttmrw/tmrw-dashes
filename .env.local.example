# Supabase — get from supabase.com > project > settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Upload password — NOT CURRENTLY IMPLEMENTED. No code reads this variable.
# POST /api/data/upload is protected by the Supabase session check in
# src/middleware.ts instead, so it is not open. Left here as a known gap:
# either wire it up in the upload route or delete this line.
UPLOAD_PW=change-me-to-something-secret

# Ingest token — REQUIRED for automated syncs. Gates POST /api/data/ingest,
# which is called by scheduled jobs that have no browser session.
#
# The endpoint fails closed: if this is unset, every request to it is rejected
# with 503, so leaving it blank disables automated ingest rather than opening
# it up. Generate a long random value, e.g.:
#
#   openssl rand -base64 32
#
# Set it in the Vercel project environment (all environments you sync to) and
# store the same value wherever the sync job runs. Do NOT prefix it
# NEXT_PUBLIC_ — that would ship it to the browser.
INGEST_TOKEN=generate-a-long-random-value
